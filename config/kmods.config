# extra kmods (=m) for the v2 package repository, on top of his kmods-extra.config
# zram: 256 MB of RAM, 34-42 MB of it available. =y together with zram-swap: the swap
# device (RAM/2, allocated lazily) is the OOM insurance for LuCI bursts and the daemons
# above. This file is concatenated last by build.sh, so =y here wins over any earlier
# assignment; keeping the two symbols in sync keeps the defconfig "nothing dropped" check
# happy (it compares the last assignment of every symbol).
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# The NetEase UU router plugin ("UU 加速器") needs the conntrack netlink interface to follow
# connections, and kmod-tun to create its tun device. kmod-tun is already =m in his
# kmods-extra.config; this is the one it does not build. Both stay in our package repository
# (config/image-must-have.txt asserts the image contains neither), so `apk add kmod-tun
# kmod-nf-conntrack-netlink` works on a release image that lists our repository.
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=m
